# Sailfish OS kernel config fragment for Samsung Galaxy S10 5G (beyondx, Exynos 9820)
# Applied on top of exynos9820-beyondx_defconfig.
# Generated from mer-kernel-check (mer_verify_kernel_config) against LineageOS lineage-23.2 kernel.

# --- REQUIRED (mer-kernel-check ERRORs) ---
CONFIG_DEVTMPFS_MOUNT=y
# CONFIG_STATIC_USERMODEHELPER is not set
# CONFIG_DUMMY is not set
CONFIG_VT=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_L2TP=y
CONFIG_L2TP_V3=y
CONFIG_L2TP_IP=y
CONFIG_INET_AH=y
CONFIG_INET_IPCOMP=y

# --- Strongly recommended for Sailfish OS 4.x/5.x ---
# systemd / sailjail (firejail) namespaces
CONFIG_USER_NS=y
CONFIG_AUTOFS4_FS=y
CONFIG_FANOTIFY=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_SECURITY_YAMA=y
CONFIG_CUSE=y
CONFIG_UEVENT_HELPER_PATH=""
# connman tethering + firewall matches
CONFIG_BRIDGE=y
CONFIG_IP6_NF_MATCH_FRAG=y
CONFIG_IP6_NF_MATCH_AH=y
CONFIG_IP6_NF_MATCH_MH=y
CONFIG_NETFILTER_XT_MATCH_ESP=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_NETLINK_ACCT=y
CONFIG_NETFILTER_XT_MATCH_NFACCT=y
# misc optional
CONFIG_ISO9660_FS=y
CONFIG_UDF_FS=y
CONFIG_BT_HCIVHCI=y

# --- Bluetooth profiles (bluez: RFCOMM for headsets/OBEX, BNEP for PAN, HIDP for keyboards) ---
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y

# --- Kernel command line ---
# The Samsung bootloader IGNORES the cmdline stored in boot.img (verified on
# device: audit=0/loop.max_part from mkbootimg --cmdline never reached
# /proc/cmdline). Extra args must be built into the kernel; CONFIG_CMDLINE_EXTEND=y
# is already set by the defconfig, so these are prepended to the bootloader's line.
# Keep the two androidboot.* args from exynos9820-beyondx_defconfig.
CONFIG_CMDLINE="androidboot.boot_devices=13d60000.ufs androidboot.super_partition=system audit=0 loop.max_part=7"

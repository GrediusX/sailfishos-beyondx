[Unit]
Description=Droid mount for /system_ext (dynamic partition)
DefaultDependencies=no
Requires=dynparts.service system.mount
After=dynparts.service system.mount
Before=local-fs.target

[Mount]
What=/dev/mapper/dynpart-system_ext
Where=/system_ext
Type=ext4
Options=ro

[Install]
WantedBy=local-fs.target

diff --git a/updater-unpack.sh b/updater-unpack.sh
index 8d0e81e..8770f8a 100644
--- a/updater-unpack.sh
+++ b/updater-unpack.sh
@@ -5,8 +5,15 @@ FS_DST="/data/.stowaways/sailfishos"
 
 rm -rf $FS_DST
 mkdir -p $FS_DST
-tar --numeric-owner -xvjf $FS_ARC -C $FS_DST
-EXIT=$?
+# HYBRIS: LineageOS recovery has no bzip2 binary; toybox provides bzcat
+if command -v bzip2 >/dev/null 2>&1; then
+    tar --numeric-owner -xvjf $FS_ARC -C $FS_DST
+    EXIT=$?
+else
+    toybox bzcat $FS_ARC | tar --numeric-owner -xf - -C $FS_DST
+    EXIT=$?
+    [ -x $FS_DST/sbin/init ] || [ -L $FS_DST/sbin/init ] || EXIT=1
+fi
 
 rm $FS_ARC
 

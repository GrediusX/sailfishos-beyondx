# ~/.hadk.env  — sourced by Platform SDK and HABUILD shells
export VENDOR="samsung"
export DEVICE="beyondx"
export HABUILD_DEVICE="beyondx"
export PORT_ARCH="aarch64"
# Android source tree (needs ~250 GB free, SSD strongly recommended)
export ANDROID_ROOT="$HOME/hadk"
# Sailfish OS release to target — check https://docs.sailfishos.org/Releases/ for the latest
export RELEASE="5.1.0.11"   # Pispala; check forum.sailfishos.org for newer point releases
